KFE_VERSION=latest
ERP_IMAGE_REGISTRY=ghcr.io/your-org
ERP_ENV_FILE=../../.env
HTTP_PORT=5080

DB_NAME=klickit
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
DB_USER=kfe_app
DB_PASSWORD=change-me
DB_SSL=false
DB_MIGRATION_USER=kfe_migrate
DB_MIGRATION_PASSWORD=change-me
REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=3000
WORKER_PORT=3001
TZ=Africa/Nairobi
SCHOOL_ID=school-instance-id
JWT_KEY_CURRENT=
APP_ENCRYPTION_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_DEFAULT=klickit-files
MINIO_USE_SSL=true
NEXT_PUBLIC_API_BASE_URL=/api/v1
