KFE_VERSION=latest
ERP_IMAGE_REGISTRY=ghcr.io/infoneysolutionsltd
ERP_ENV_FILE=../../.env
HTTP_PORT=5080

# Optional: set this only when Gateway should expose the ERP.
# GATEWAY_NETWORK=edge_network

DB_NAME=klickit
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
DB_USER=kfe_app
DB_PASSWORD=change-me
DB_SSL=false
DB_MIGRATION_USER=kfe_migrate
DB_MIGRATION_PASSWORD=change-me
REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=3000
WORKER_PORT=3001
TZ=Africa/Nairobi
SCHOOL_ID=school-instance-id

JWT_KEY_CURRENT=
APP_ENCRYPTION_KEY=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET_DEFAULT=klickit-files
MINIO_USE_SSL=false
# Public MinIO S3 hostname used in browser-facing signed URLs.
# MINIO_PUBLIC_ENDPOINT=files-dev.example.com
# MINIO_PUBLIC_USE_SSL=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
NEXT_PUBLIC_API_BASE_URL=/api/v1
